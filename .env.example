# Copy this file to .env and fill in real values. Never commit .env.

APP_ENV=production
# Use "local" only when developing on your own machine — it turns on PHP
# error display and disables the secure-cookie flag, since local dev usually
# isn't HTTPS.
APP_TIMEZONE=America/Los_Angeles

# --- Database (Hostinger hPanel -> Databases -> MySQL Databases) ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# --- TMDB (film metadata/verification, CLAUDE.md §7.1) ---
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Google Books (book metadata/verification, CLAUDE.md §7.1) ---
# Optional — search works without a key at low volume. Get one at
# https://console.cloud.google.com/apis/library/books.googleapis.com if you
# need higher limits.
GOOGLE_BOOKS_API_KEY=

# --- NewsAPI (review/write-up source, CLAUDE.md §7.2) ---
# Get a key at https://newsapi.org/register — READ app/Services/NewsClient.php
# first: confirm your plan actually covers a deployed production app before
# relying on this, not just local testing.
NEWS_API_KEY=

# --- Reddit (Phase 2 source, CLAUDE.md §7.2) ---
# Register a "script" or "web app" at https://www.reddit.com/prefs/apps.
# READ app/Services/RedditClient.php first — Reddit's API terms/pricing have
# changed before and are worth re-checking.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive User-Agent identifying your app + contact.
REDDIT_USER_AGENT="ReviewMangler/1.0 (by /u/yourusername)"

# --- YouTube Data API (Phase 2 source, CLAUDE.md §7.2) ---
# Enable "YouTube Data API v3" at https://console.cloud.google.com and create
# an API key. Can be the same Google Cloud project as GOOGLE_BOOKS_API_KEY.
YOUTUBE_API_KEY=

# --- Scraper contact (Phase 3, Tier B source, CLAUDE.md §7.2) ---
# LetterboxdClient.php sends this in its User-Agent so any site it scrapes
# can see an honest way to reach you — required by the spec's scraping
# ethics section, not optional. An email address you actually check.
SCRAPER_CONTACT=

# --- Claude API (classification pipeline, CLAUDE.md §7.3) ---
# https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=
# Check https://docs.claude.com/en/docs/about-claude/models for the current
# model ID before deploying — this is deliberately left blank rather than
# hardcoding a value that may be stale by the time you set this up.
CLAUDE_MODEL=

# --- One-time browser account setup (public/setup_admin.php) ---
# Only needed if your plan has no SSH access. Set this to a long random
# value before you deploy, use it once, then delete public/setup_admin.php
# entirely — see the warning at the top of that file.
SETUP_TOKEN=

# --- Behavior ---
# How many hours must pass between a user's manual "check now" clicks on the
# same title, to keep this calm rather than a doomscroll trigger (§4, §7.2).
MANUAL_REFRESH_COOLDOWN_HOURS=24

# --- Digest email delivery (Phase 2, CLAUDE.md §7.6) ---
# Leave SMTP_HOST blank to fall back to PHP's built-in mail() (works on many
# shared hosts out of the box, but can't authenticate and is more likely to
# be marked spam). Recommended: Hostinger's own mailbox SMTP settings, found
# in hPanel -> Emails -> your mailbox -> Configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Review Mangler"
