# Defense in depth: if the hosting document root ever gets pointed at the
# project root instead of /public (it should be /public — see README), this
# blocks direct access to everything except the public/ folder.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
